# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PUBLIC_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Evolution API Configuration
NEXT_PUBLIC_EVOLUTION_API_URL=YOUR_EVOLUTION_API_URL
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY

# N8N Webhook Configuration (OBRIGATÓRIO)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com

# Default Instance Configuration (for existing setup)
DEFAULT_INSTANCE_TOKEN=YOUR_INSTANCE_TOKEN
DEFAULT_WHATSAPP_NUMBER=YOUR_WPP_NUMBER

# Modo Desenvolvimento (DESABILITAR AUTENTICAÇÃO E RLS)
# ⚠️ ATENÇÃO: Use apenas em desenvolvimento local!
# ⚠️ NUNCA use DISABLE_AUTH=true em produção!
DISABLE_AUTH=false